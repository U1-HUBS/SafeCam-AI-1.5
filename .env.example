# CCTV Sentinel Environment Configuration

# Flask / Server
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

# Database (defaults to local SQLite if omitted)
# Example for PostgreSQL: postgresql://user:password@localhost:5432/cctv_sentinel
DATABASE_URL=sqlite:///storage/safecam.db

# AI Inference Settings
# Set LOAD_CLIP_MODEL=1 to download & run OpenAI CLIP ViT-B/32 weights
# Set LOAD_CLIP_MODEL=0 to use fast simulation / test mode
LOAD_CLIP_MODEL=0
DEFAULT_AI_THRESHOLD=0.25
DEFAULT_SAMPLING_RATE=2

# Rolling Buffer & Incident Clipping (seconds)
DEFAULT_PRE_BUFFER_SECONDS=8
DEFAULT_POST_BUFFER_SECONDS=8

# Temporal Event Aggregator
DEFAULT_ROLLING_WINDOW_SECONDS=6
DEFAULT_POSITIVE_RATIO=0.50
DEFAULT_MIN_POSITIVE_FRAMES=3
DEFAULT_COOLDOWN_SECONDS=20

# Frontend API URL (for Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
